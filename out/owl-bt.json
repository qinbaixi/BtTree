{
    "types": {
        "blackboardKey": {
            "type": "string",
            "pattern": "[A-Za-z_][A-Za-z0-9_]*"
        },
        "probability": {
            "type": "number",
            "pattern": "(0(\\.\\d+)?|1(\\.0+)?)"
        }
    },
    "nodes": [
        {
            "name": "Selector",
            "icon": "question",
            "isComposite": true,
            "description": "Runs children in order until one succeeds"
        },
        {
            "name": "Sequence",
            "icon": "arrow-right",
            "isComposite": true,
            "description": "Runs children in order until one fails"
        },
        {
            "name": "Parallel",
            "icon": "bars",
            "isComposite": true,
            "description": "Runs all children at once",
            "properties": [
                {
                    "name": "Policy",
                    "type": "enum",
                    "values": ["RequireOne", "RequireAll"],
                    "default": "RequireOne",
                    "description": "How many children must succeed"
                }
            ]
        },
        {
            "name": "RandomSelector",
            "icon": "shuffle",
            "color": "#c6a35c",
            "isComposite": true,
            "description": "Runs children in random order, weighted by {{Weights}}",
            "properties": [
                {
                    "name": "Weights",
                    "type": "string",
                    "default": "",
                    "description": "Comma separated weights, one per child"
                }
            ]
        },
        {
            "name": "ActionBase",
            "icon": "gear",
            "isAbstract": true,
            "properties": [
                {
                    "name": "Async",
                    "type": "bool",
                    "default": false,
                    "description": "Action finishes in a later tick"
                }
            ]
        },
        {
            "name": "Wait",
            "base": "ActionBase",
            "icon": "hourglass-half",
            "description": "Wait {{Duration}}s",
            "properties": [
                {
                    "name": "Duration",
                    "type": "number",
                    "min": 0,
                    "max": 3600,
                    "default": 1
                }
            ]
        },
        {
            "name": "Log",
            "base": "ActionBase",
            "icon": "message",
            "description": "Log [{{Level}}] {{Message}}",
            "properties": [
                {
                    "name": "Message",
                    "type": "string",
                    "default": "Hello"
                },
                {
                    "name": "Level",
                    "type": "enum",
                    "values": ["Info", "Warning", "Error"],
                    "default": "Info"
                }
            ]
        },
        {
            "name": "MoveTo",
            "base": "ActionBase",
            "icon": "person-walking",
            "description": "Move to {{Target}} at speed {{Speed}}",
            "properties": [
                {
                    "name": "Target",
                    "type": "blackboardKey",
                    "default": "Target"
                },
                {
                    "name": "Speed",
                    "type": "number",
                    "min": 0,
                    "max": 100,
                    "default": 50
                },
                {
                    "name": "Mode",
                    "type": "enum",
                    "values": ["Walk", "Run"],
                    "default": "Walk"
                }
            ]
        },
        {
            "name": "SetBlackboardValue",
            "base": "ActionBase",
            "icon": "pen",
            "description": "{{Key}} = {{Value}}",
            "properties": [
                {
                    "name": "Key",
                    "type": "blackboardKey",
                    "default": "Target"
                },
                {
                    "name": "Value",
                    "type": "string",
                    "default": ""
                }
            ]
        },
        {
            "name": "Succeed",
            "base": "ActionBase",
            "icon": "check",
            "description": "Always succeeds"
        },
        {
            "name": "Fail",
            "base": "ActionBase",
            "icon": "xmark",
            "description": "Always fails"
        },
        {
            "name": "RandomChance",
            "base": "ActionBase",
            "icon": "dice",
            "description": "Succeeds with chance {{Chance}}",
            "properties": [
                {
                    "name": "Chance",
                    "type": "probability",
                    "default": 0.5
                }
            ]
        }
    ],
    "decorators": [
        {
            "name": "Failure",
            "icon": "thumbs-down"
        },
        {
            "name": "Invert",
            "icon": "right-left"
        },
        {
            "name": "Success",
            "icon": "thumbs-up"
        },
        {
            "name": "IsBlackboardValueSet",
            "icon": "table",
            "description": "Is blackboard value \"{{Field}}\" set",
            "properties": [
                {
                    "name": "Field",
                    "type": "blackboardKey"
                }
            ]
        },
        {
            "name": "Cooldown",
            "icon": "clock",
            "description": "Cooldown {{Seconds}}s",
            "properties": [
                {
                    "name": "Seconds",
                    "type": "number",
                    "min": 0,
                    "default": 1
                }
            ]
        },
        {
            "name": "Loop",
            "icon": "repeat",
            "color": "#6fa8c6",
            "description": "Loop {{Count}} times",
            "properties": [
                {
                    "name": "Count",
                    "type": "number",
                    "min": 1,
                    "default": 3
                },
                {
                    "name": "Infinite",
                    "type": "bool",
                    "default": false,
                    "description": "Loop forever, ignoring Count"
                }
            ]
        },
        {
            "name": "TimeLimit",
            "icon": "stopwatch",
            "description": "Time limit {{Seconds}}s",
            "properties": [
                {
                    "name": "Seconds",
                    "type": "number",
                    "min": 0,
                    "default": 5
                }
            ]
        }
    ],
    "services": [
        {
            "name": "Sample service",
            "icon": "gear",
            "description": "Sample service",
            "properties": [
                {
                    "name": "BlackboardKey",
                    "type": "string",
                    "default": "Target"
                }
            ]
        },
        {
            "name": "UpdateTarget",
            "icon": "crosshairs",
            "description": "Update {{Key}} within {{Range}}",
            "properties": [
                {
                    "name": "Key",
                    "type": "blackboardKey",
                    "default": "Target"
                },
                {
                    "name": "Range",
                    "type": "number",
                    "min": 0,
                    "default": 10
                }
            ]
        },
        {
            "name": "LogTick",
            "icon": "message",
            "description": "Tick: {{Message}}",
            "properties": [
                {
                    "name": "Message",
                    "type": "string",
                    "default": "tick"
                }
            ]
        }
    ]
}
