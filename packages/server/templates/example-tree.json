{
    "type": "Selector",
    "name": "rootNode",
    "label": "Root",
    "comment": "Example tree: patrols when idle, fights when an enemy is known",
    "services": [
        {
            "type": "Sample service",
            "properties": [
                { "name": "BlackboardKey", "value": "Target" }
            ],
            "timeBetweenTicks": 0.5,
            "firstTickTime": 0
        }
    ],
    "childNodes": [
        {
            "type": "Sequence",
            "label": "Patrol",
            "comment": "Walk the route while points remain",
            "decorators": [
                {
                    "type": "IsBlackboardValueSet",
                    "properties": [
                        { "name": "Field", "value": "PatrolPoints" }
                    ]
                }
            ],
            "childNodes": [
                {
                    "type": "MoveTo",
                    "label": "Go to waypoint",
                    "properties": [
                        { "name": "Target", "value": "Waypoint" },
                        { "name": "Speed", "value": 80 },
                        { "name": "Mode", "value": "Run" }
                    ],
                    "decorators": [
                        {
                            "type": "Cooldown",
                            "properties": [
                                { "name": "Seconds", "value": 2 }
                            ],
                            "periodic": true
                        }
                    ]
                },
                {
                    "type": "Wait",
                    "label": "Look around",
                    "properties": [
                        { "name": "Duration", "value": 3 }
                    ]
                },
                {
                    "type": "SetBlackboardValue",
                    "label": "Next point",
                    "properties": [
                        { "name": "Key", "value": "PatrolIndex" },
                        { "name": "Value", "value": "1" }
                    ]
                }
            ]
        },
        {
            "type": "Sequence",
            "label": "Combat",
            "comment": "Engage the enemy for at most ten seconds",
            "decorators": [
                {
                    "type": "TimeLimit",
                    "properties": [
                        { "name": "Seconds", "value": 10 }
                    ]
                }
            ],
            "services": [
                {
                    "type": "UpdateTarget",
                    "label": "Track enemy",
                    "properties": [
                        { "name": "Key", "value": "Enemy" },
                        { "name": "Range", "value": 20 }
                    ],
                    "timeBetweenTicks": 0.2
                }
            ],
            "childNodes": [
                {
                    "type": "Log",
                    "label": "Announce",
                    "properties": [
                        { "name": "Message", "value": "Enemy spotted" },
                        { "name": "Level", "value": "Warning" }
                    ]
                },
                {
                    "type": "RandomChance",
                    "label": "Hesitate?",
                    "properties": [
                        { "name": "Chance", "value": 0.25 }
                    ]
                },
                {
                    "type": "Parallel",
                    "label": "Attack and watch",
                    "properties": [
                        { "name": "Policy", "value": "RequireOne" }
                    ],
                    "childNodes": [
                        {
                            "type": "MoveTo",
                            "label": "Close in",
                            "properties": [
                                { "name": "Target", "value": "Enemy" },
                                { "name": "Speed", "value": 100 },
                                { "name": "Mode", "value": "Run" }
                            ]
                        },
                        {
                            "type": "Wait",
                            "label": "Wind up",
                            "properties": [
                                { "name": "Duration", "value": 1 }
                            ],
                            "decorators": [
                                {
                                    "type": "IsBlackboardValueSet",
                                    "inverseCheckCondition": true,
                                    "properties": [
                                        { "name": "Field", "value": "Enemy" }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "type": "RandomSelector",
            "label": "Idle",
            "comment": "Pick one idle behaviour at random",
            "properties": [
                { "name": "Weights", "value": "3,1" }
            ],
            "childNodes": [
                {
                    "type": "Wait",
                    "label": "Stand still",
                    "properties": [
                        { "name": "Duration", "value": 2 }
                    ]
                },
                {
                    "type": "Log",
                    "label": "Daydream",
                    "properties": [
                        { "name": "Message", "value": "Nothing to do" }
                    ]
                }
            ]
        }
    ]
}
