{
    "types": {
        "blackboardKey": {
            "type": "string",
            "pattern": "[A-Za-z_][A-Za-z0-9_]*"
        },
        "probability": {
            "type": "number",
            "pattern": "(0(\\.\\d+)?|1(\\.0+)?)"
        }
    },
    "nodes": [
        {
            "name": "Selector",
            "icon": "question",
            "isComposite": true,
            "description": "依次执行子节点，直到有一个成功"
        },
        {
            "name": "Sequence",
            "icon": "arrow-right",
            "isComposite": true,
            "description": "依次执行子节点，直到有一个失败"
        },
        {
            "name": "Parallel",
            "icon": "bars",
            "isComposite": true,
            "description": "同时执行所有子节点",
            "properties": [
                {
                    "name": "Policy",
                    "type": "enum",
                    "values": ["RequireOne", "RequireAll"],
                    "default": "RequireOne",
                    "description": "需要多少个子节点成功"
                }
            ]
        },
        {
            "name": "RandomSelector",
            "icon": "shuffle",
            "color": "#c6a35c",
            "isComposite": true,
            "description": "按权重 {{Weights}} 随机顺序执行子节点",
            "properties": [
                {
                    "name": "Weights",
                    "type": "string",
                    "default": "",
                    "description": "逗号分隔的权重，每个子节点一个"
                }
            ]
        },
        {
            "name": "ActionBase",
            "icon": "gear",
            "isAbstract": true,
            "properties": [
                {
                    "name": "Async",
                    "type": "bool",
                    "default": false,
                    "description": "动作在之后的 tick 中完成"
                }
            ]
        },
        {
            "name": "Wait",
            "base": "ActionBase",
            "icon": "hourglass-half",
            "description": "等待 {{Duration}} 秒",
            "properties": [
                {
                    "name": "Duration",
                    "type": "number",
                    "min": 0,
                    "max": 3600,
                    "default": 1
                }
            ]
        },
        {
            "name": "Log",
            "base": "ActionBase",
            "icon": "message",
            "description": "输出日志 [{{Level}}] {{Message}}",
            "properties": [
                {
                    "name": "Message",
                    "type": "string",
                    "default": "Hello"
                },
                {
                    "name": "Level",
                    "type": "enum",
                    "values": ["Info", "Warning", "Error"],
                    "default": "Info"
                }
            ]
        },
        {
            "name": "MoveTo",
            "base": "ActionBase",
            "icon": "person-walking",
            "description": "以速度 {{Speed}} 移动到 {{Target}}",
            "properties": [
                {
                    "name": "Target",
                    "type": "blackboardKey",
                    "default": "Target"
                },
                {
                    "name": "Speed",
                    "type": "number",
                    "min": 0,
                    "max": 100,
                    "default": 50
                },
                {
                    "name": "Mode",
                    "type": "enum",
                    "values": ["Walk", "Run"],
                    "default": "Walk"
                }
            ]
        },
        {
            "name": "SetBlackboardValue",
            "base": "ActionBase",
            "icon": "pen",
            "description": "设置黑板值 {{Key}} = {{Value}}",
            "properties": [
                {
                    "name": "Key",
                    "type": "blackboardKey",
                    "default": "Target"
                },
                {
                    "name": "Value",
                    "type": "string",
                    "default": ""
                }
            ]
        },
        {
            "name": "Succeed",
            "base": "ActionBase",
            "icon": "check",
            "description": "总是成功"
        },
        {
            "name": "Fail",
            "base": "ActionBase",
            "icon": "xmark",
            "description": "总是失败"
        },
        {
            "name": "RandomChance",
            "base": "ActionBase",
            "icon": "dice",
            "description": "以 {{Chance}} 的概率成功",
            "properties": [
                {
                    "name": "Chance",
                    "type": "probability",
                    "default": 0.5
                }
            ]
        }
    ],
    "decorators": [
        {
            "name": "Failure",
            "icon": "thumbs-down"
        },
        {
            "name": "Invert",
            "icon": "right-left"
        },
        {
            "name": "Success",
            "icon": "thumbs-up"
        },
        {
            "name": "IsBlackboardValueSet",
            "icon": "table",
            "description": "黑板值 \"{{Field}}\" 已设置",
            "properties": [
                {
                    "name": "Field",
                    "type": "blackboardKey"
                }
            ]
        },
        {
            "name": "Cooldown",
            "icon": "clock",
            "description": "冷却 {{Seconds}} 秒",
            "properties": [
                {
                    "name": "Seconds",
                    "type": "number",
                    "min": 0,
                    "default": 1
                }
            ]
        },
        {
            "name": "Loop",
            "icon": "repeat",
            "color": "#6fa8c6",
            "description": "循环 {{Count}} 次",
            "properties": [
                {
                    "name": "Count",
                    "type": "number",
                    "min": 1,
                    "default": 3
                },
                {
                    "name": "Infinite",
                    "type": "bool",
                    "default": false,
                    "description": "无限循环，忽略 Count"
                }
            ]
        },
        {
            "name": "TimeLimit",
            "icon": "stopwatch",
            "description": "限时 {{Seconds}} 秒",
            "properties": [
                {
                    "name": "Seconds",
                    "type": "number",
                    "min": 0,
                    "default": 5
                }
            ]
        }
    ],
    "services": [
        {
            "name": "Sample service",
            "icon": "gear",
            "description": "示例服务",
            "properties": [
                {
                    "name": "BlackboardKey",
                    "type": "string",
                    "default": "Target"
                }
            ]
        },
        {
            "name": "UpdateTarget",
            "icon": "crosshairs",
            "description": "更新 {{Range}} 范围内的 {{Key}}",
            "properties": [
                {
                    "name": "Key",
                    "type": "blackboardKey",
                    "default": "Target"
                },
                {
                    "name": "Range",
                    "type": "number",
                    "min": 0,
                    "default": 10
                }
            ]
        },
        {
            "name": "LogTick",
            "icon": "message",
            "description": "每次 tick 输出：{{Message}}",
            "properties": [
                {
                    "name": "Message",
                    "type": "string",
                    "default": "tick"
                }
            ]
        }
    ]
}
