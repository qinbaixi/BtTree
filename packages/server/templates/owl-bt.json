{
    "types": {
        "blackboardKey": {
            "type": "string",
            "pattern": "[A-Za-z_][A-Za-z0-9_]*"
        },
        "probability": {
            "type": "number",
            "pattern": "(0(\\.\\d+)?|1(\\.0+)?)"
        }
    },
    "nodes": [
        {
            "name": "Selector",
            "icon": "question",
            "isComposite": true,
            "description": "依次执行子节点，直到有一个成功"
        },
        {
            "name": "Sequence",
            "icon": "arrow-right",
            "isComposite": true,
            "description": "依次执行子节点，直到有一个失败"
        },
        {
            "name": "Parallel",
            "icon": "bars",
            "isComposite": true,
            "description": "同时执行所有子节点",
            "properties": [
                {
                    "name": "Policy",
                    "type": "enum",
                    "values": ["RequireOne", "RequireAll"],
                    "default": "RequireOne",
                    "description": "需要多少个子节点成功"
                }
            ]
        },
        {
            "name": "RandomSelector",
            "icon": "shuffle",
            "color": "#c6a35c",
            "isComposite": true,
            "description": "按权重 {{Weights}} 随机顺序执行子节点",
            "properties": [
                {
                    "name": "Weights",
                    "type": "string",
                    "default": "",
                    "description": "逗号分隔的权重，每个子节点一个"
                }
            ]
        },
        {
            "name": "UtilitySelector",
            "icon": "scale-balanced",
            "isComposite": true,
            "description": "效用选择：给每个子节点打分，执行分数最高的（{{Selection}}）",
            "properties": [
                {
                    "name": "OnChildFailure",
                    "type": "enum",
                    "values": ["TryNext", "Fail"],
                    "default": "TryNext",
                    "description": "TryNext：选中的子节点失败后按分数试下一个；Fail：直接失败"
                },
                {
                    "name": "Selection",
                    "type": "enum",
                    "values": ["Highest", "WeightedRandom"],
                    "default": "Highest",
                    "description": "Highest：选最高分；WeightedRandom：在前 RandomTop 名里按分数加权随机"
                },
                {
                    "name": "RandomTop",
                    "type": "number",
                    "min": 0,
                    "default": 0,
                    "description": "WeightedRandom 时参与随机的名次数，0 = 全部"
                },
                {
                    "name": "MinScore",
                    "type": "number",
                    "min": 0,
                    "default": 0,
                    "description": "低于这个分数的子节点不执行"
                }
            ],
            "simulate": {
                "composite": "utility"
            }
        },
        {
            "name": "ActionBase",
            "icon": "gear",
            "isAbstract": true,
            "properties": [
                {
                    "name": "Async",
                    "type": "bool",
                    "default": false,
                    "description": "动作在之后的 tick 中完成"
                }
            ]
        },
        {
            "name": "Wait",
            "base": "ActionBase",
            "icon": "hourglass-half",
            "description": "等待 {{Duration}} 秒",
            "simulate": {
                "mode": "rule",
                "duration": "{{Duration}}"
            },
            "properties": [
                {
                    "name": "Duration",
                    "type": "number",
                    "min": 0,
                    "max": 3600,
                    "default": 1
                }
            ]
        },
        {
            "name": "Log",
            "base": "ActionBase",
            "icon": "message",
            "description": "输出日志 [{{Level}}] {{Message}}",
            "simulate": {
                "mode": "success"
            },
            "properties": [
                {
                    "name": "Message",
                    "type": "string",
                    "default": "Hello"
                },
                {
                    "name": "Level",
                    "type": "enum",
                    "values": ["Info", "Warning", "Error"],
                    "default": "Info"
                }
            ]
        },
        {
            "name": "MoveTo",
            "base": "ActionBase",
            "icon": "person-walking",
            "description": "以速度 {{Speed}} 移动到 {{Target}}",
            "simulate": {
                "mode": "success",
                "duration": 2
            },
            "properties": [
                {
                    "name": "Target",
                    "type": "blackboardKey",
                    "default": "Target"
                },
                {
                    "name": "Speed",
                    "type": "number",
                    "min": 0,
                    "max": 100,
                    "default": 50
                },
                {
                    "name": "Mode",
                    "type": "enum",
                    "values": ["Walk", "Run"],
                    "default": "Walk"
                }
            ]
        },
        {
            "name": "SetBlackboardValue",
            "base": "ActionBase",
            "icon": "pen",
            "description": "设置黑板值 {{Key}} = {{Value}}",
            "simulate": {
                "mode": "success"
            },
            "properties": [
                {
                    "name": "Key",
                    "type": "blackboardKey",
                    "default": "Target"
                },
                {
                    "name": "Value",
                    "type": "string",
                    "default": ""
                }
            ]
        },
        {
            "name": "Succeed",
            "base": "ActionBase",
            "icon": "check",
            "description": "总是成功",
            "simulate": {
                "mode": "success"
            }
        },
        {
            "name": "Fail",
            "base": "ActionBase",
            "icon": "xmark",
            "description": "总是失败",
            "simulate": {
                "mode": "failure"
            }
        },
        {
            "name": "RandomChance",
            "base": "ActionBase",
            "icon": "dice",
            "description": "以 {{Chance}} 的概率成功",
            "properties": [
                {
                    "name": "Chance",
                    "type": "probability",
                    "default": 0.5
                }
            ]
        },
        {
            "name": "SubTree",
            "icon": "diagram-project",
            "subtree": true,
            "description": "运行子树 {{Tree}}",
            "properties": [
                {
                    "name": "Tree",
                    "type": "string",
                    "default": "",
                    "description": "要运行的树文件，相对项目目录的路径"
                }
            ]
        }
    ],
    "decorators": [
        {
            "name": "Utility",
            "icon": "scale-balanced",
            "description": "固定分数 {{Score}}",
            "properties": [
                {
                    "name": "Score",
                    "type": "number",
                    "min": 0,
                    "default": 0.5,
                    "description": "效用分数，父节点为 UtilitySelector 时使用"
                }
            ],
            "simulate": {
                "score": "{{Score}}"
            }
        },
        {
            "name": "Consideration",
            "icon": "chart-line",
            "description": "{{Input}}（{{Min}}–{{Max}}）经 {{Curve}} 曲线打分",
            "properties": [
                {
                    "name": "Input",
                    "type": "blackboardKey",
                    "description": "作为输入的黑板键"
                },
                {
                    "name": "Min",
                    "type": "number",
                    "default": 0
                },
                {
                    "name": "Max",
                    "type": "number",
                    "default": 100
                },
                {
                    "name": "Curve",
                    "type": "enum",
                    "values": [
                        "Linear",
                        "InverseLinear",
                        "Quadratic",
                        "InverseQuadratic",
                        "Logistic",
                        "InverseLogistic",
                        "Step",
                        "InverseStep"
                    ],
                    "default": "Linear",
                    "description": "把归一化到 0–1 的输入映射成分数的响应曲线"
                }
            ],
            "simulate": {
                "score": "curve({{Curve}}, normalize(get({{Input}}), {{Min}}, {{Max}}))"
            }
        },
        {
            "name": "Failure",
            "icon": "thumbs-down",
            "simulate": {
                "decorator": "forceFailure"
            }
        },
        {
            "name": "Invert",
            "icon": "right-left",
            "simulate": {
                "decorator": "invert"
            }
        },
        {
            "name": "Success",
            "icon": "thumbs-up",
            "simulate": {
                "decorator": "forceSuccess"
            }
        },
        {
            "name": "IsBlackboardValueSet",
            "icon": "table",
            "description": "黑板值 \"{{Field}}\" 已设置",
            "properties": [
                {
                    "name": "Field",
                    "type": "blackboardKey"
                }
            ]
        },
        {
            "name": "Cooldown",
            "icon": "clock",
            "description": "冷却 {{Seconds}} 秒",
            "simulate": {
                "decorator": "cooldown",
                "ticks": "{{Seconds}}"
            },
            "properties": [
                {
                    "name": "Seconds",
                    "type": "number",
                    "min": 0,
                    "default": 1
                }
            ]
        },
        {
            "name": "Loop",
            "icon": "repeat",
            "color": "#6fa8c6",
            "description": "循环 {{Count}} 次",
            "simulate": {
                "decorator": "loop",
                "count": "{{Count}}"
            },
            "properties": [
                {
                    "name": "Count",
                    "type": "number",
                    "min": 1,
                    "default": 3
                },
                {
                    "name": "Infinite",
                    "type": "bool",
                    "default": false,
                    "description": "无限循环，忽略 Count"
                }
            ]
        },
        {
            "name": "TimeLimit",
            "icon": "stopwatch",
            "description": "限时 {{Seconds}} 秒",
            "simulate": {
                "decorator": "timeLimit",
                "ticks": "{{Seconds}}"
            },
            "properties": [
                {
                    "name": "Seconds",
                    "type": "number",
                    "min": 0,
                    "default": 5
                }
            ]
        }
    ],
    "services": [
        {
            "name": "Sample service",
            "icon": "gear",
            "description": "示例服务",
            "properties": [
                {
                    "name": "BlackboardKey",
                    "type": "string",
                    "default": "Target"
                }
            ]
        },
        {
            "name": "UpdateTarget",
            "icon": "crosshairs",
            "description": "更新 {{Range}} 范围内的 {{Key}}",
            "properties": [
                {
                    "name": "Key",
                    "type": "blackboardKey",
                    "default": "Target"
                },
                {
                    "name": "Range",
                    "type": "number",
                    "min": 0,
                    "default": 10
                }
            ]
        },
        {
            "name": "LogTick",
            "icon": "message",
            "description": "每次 tick 输出：{{Message}}",
            "properties": [
                {
                    "name": "Message",
                    "type": "string",
                    "default": "tick"
                }
            ]
        }
    ],
    "blackboard": [
        {
            "name": "Target",
            "type": "string",
            "default": "",
            "description": "当前目标"
        },
        {
            "name": "Enemy",
            "type": "string",
            "default": "",
            "description": "视野内的敌人，没有时为空"
        },
        {
            "name": "Waypoint",
            "type": "string",
            "default": "",
            "description": "下一个巡逻点"
        },
        {
            "name": "PatrolPoints",
            "type": "any",
            "description": "巡逻点列表"
        },
        {
            "name": "PatrolIndex",
            "type": "number",
            "default": 0,
            "description": "当前巡逻点序号"
        }
    ]
}
