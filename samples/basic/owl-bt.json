{
  "types": {
    "identifier": {
      "type": "string",
      "pattern": "[A-Za-z_][A-Za-z0-9_]*"
    },
    "seconds": {
      "type": "number"
    },
    "blackboardKey": {
      "type": "string",
      "pattern": "[A-Za-z_][A-Za-z0-9_]*"
    }
  },
  "nodes": [
    {
      "name": "Selector",
      "icon": "question",
      "color": "#d08038",
      "isComposite": true,
      "description": "依次执行子节点，直到有一个成功"
    },
    {
      "name": "Sequence",
      "icon": "arrow-right",
      "color": "#d08038",
      "isComposite": true,
      "description": "依次执行子节点，直到有一个失败"
    },
    {
      "name": "Parallel",
      "icon": "layer-group",
      "isComposite": true,
      "description": "同时执行所有子节点",
      "properties": [
        {
          "name": "Policy",
          "type": "enum",
          "values": ["RequireOne", "RequireAll"],
          "default": "RequireAll",
          "description": "需要多少个子节点成功"
        }
      ]
    },
    {
      "name": "ActionBase",
      "icon": "gear",
      "isAbstract": true,
      "properties": [
        {
          "name": "Timeout",
          "type": "number",
          "min": 0,
          "max": 60,
          "default": 5,
          "description": "动作超时放弃前的秒数"
        }
      ]
    },
    {
      "name": "Targetable",
      "isAbstract": true,
      "properties": [
        {
          "name": "Target",
          "type": "identifier",
          "default": "Enemy"
        }
      ]
    },
    {
      "name": "MoveTo",
      "base": "ActionBase",
      "icon": "person-walking",
      "color": "#955cc6",
      "description": "以速度 {{Speed}} 移动到 {{Target}}",
      "properties": [
        {
          "name": "Target",
          "type": "string"
        },
        {
          "name": "Speed",
          "type": "number",
          "min": 0,
          "max": 100,
          "default": 50
        },
        {
          "name": "Mode",
          "type": "enum",
          "values": ["Walk", "Run", "Sprint"],
          "default": "Walk"
        }
      ]
    },
    {
      "name": "Attack",
      "base": ["ActionBase", "Targetable"],
      "icon": "crosshairs",
      "color": "#955cc6",
      "description": "攻击 {{Target}}",
      "properties": [
        {
          "name": "Damage",
          "type": "number",
          "min": 1,
          "max": 999
        },
        {
          "name": "Melee",
          "type": "bool",
          "default": true
        },
        {
          "name": "Id",
          "type": "identifier"
        }
      ]
    },
    {
      "name": "Wait",
      "base": "ActionBase",
      "icon": "hourglass-half",
      "color": "#955cc6",
      "description": "等待 {{Timeout}} 秒"
    },
    {
      "name": "UtilitySelector",
      "icon": "scale-balanced",
      "isComposite": true,
      "description": "效用选择：给每个子节点打分，执行分数最高的（{{Selection}}）",
      "properties": [
        {
          "name": "OnChildFailure",
          "type": "enum",
          "values": ["TryNext", "Fail"],
          "default": "TryNext",
          "description": "TryNext：选中的子节点失败后按分数试下一个；Fail：直接失败"
        },
        {
          "name": "Selection",
          "type": "enum",
          "values": ["Highest", "WeightedRandom"],
          "default": "Highest",
          "description": "Highest：选最高分；WeightedRandom：在前 RandomTop 名里按分数加权随机"
        },
        {
          "name": "RandomTop",
          "type": "number",
          "min": 0,
          "default": 0,
          "description": "WeightedRandom 时参与随机的名次数，0 = 全部"
        },
        {
          "name": "MinScore",
          "type": "number",
          "min": 0,
          "default": 0,
          "description": "低于这个分数的子节点不执行"
        }
      ],
      "simulate": {
        "composite": "utility"
      }
    }
  ],
  "decorators": [
    {
      "name": "Failure",
      "icon": "thumbs-down"
    },
    {
      "name": "Invert",
      "icon": "right-left"
    },
    {
      "name": "Success",
      "icon": "thumbs-up"
    },
    {
      "name": "IsBlackboardValueSet",
      "icon": "table",
      "description": "黑板值 \"{{Field}}\" 已设置",
      "properties": [
        {
          "name": "Field",
          "type": "identifier"
        }
      ]
    },
    {
      "name": "Cooldown",
      "icon": "clock",
      "description": "冷却 {{Seconds}} 秒",
      "properties": [
        {
          "name": "Seconds",
          "type": "seconds",
          "min": 0,
          "default": 1
        }
      ]
    },
    {
      "name": "Utility",
      "icon": "scale-balanced",
      "description": "固定分数 {{Score}}",
      "properties": [
        {
          "name": "Score",
          "type": "number",
          "min": 0,
          "default": 0.5,
          "description": "效用分数，父节点为 UtilitySelector 时使用"
        }
      ],
      "simulate": {
        "score": "{{Score}}"
      }
    },
    {
      "name": "Consideration",
      "icon": "chart-line",
      "description": "{{Input}}（{{Min}}–{{Max}}）经 {{Curve}} 曲线打分",
      "properties": [
        {
          "name": "Input",
          "type": "blackboardKey",
          "description": "作为输入的黑板键"
        },
        {
          "name": "Min",
          "type": "number",
          "default": 0
        },
        {
          "name": "Max",
          "type": "number",
          "default": 100
        },
        {
          "name": "Curve",
          "type": "enum",
          "values": [
            "Linear",
            "InverseLinear",
            "Quadratic",
            "InverseQuadratic",
            "Logistic",
            "InverseLogistic",
            "Step",
            "InverseStep"
          ],
          "default": "Linear",
          "description": "把归一化到 0–1 的输入映射成分数的响应曲线"
        }
      ],
      "simulate": {
        "score": "curve({{Curve}}, normalize(get({{Input}}), {{Min}}, {{Max}}))"
      }
    }
  ],
  "services": [
    {
      "name": "Sample service",
      "icon": "gear",
      "description": "示例服务",
      "properties": [
        {
          "name": "BlackboardKey",
          "type": "string",
          "default": "Target"
        }
      ]
    },
    {
      "name": "UpdateTarget",
      "icon": "bullseye",
      "color": "#5cc690",
      "description": "每次 tick 更新 {{Key}}",
      "properties": [
        {
          "name": "Key",
          "type": "identifier",
          "default": "Target"
        }
      ]
    }
  ]
}
