{
  "types": {
    "identifier": {
      "type": "string",
      "pattern": "[A-Za-z_][A-Za-z0-9_]*"
    },
    "seconds": {
      "type": "number"
    }
  },
  "nodes": [
    {
      "name": "Selector",
      "icon": "question",
      "color": "#d08038",
      "isComposite": true,
      "description": "依次执行子节点，直到有一个成功"
    },
    {
      "name": "Sequence",
      "icon": "arrow-right",
      "color": "#d08038",
      "isComposite": true,
      "description": "依次执行子节点，直到有一个失败"
    },
    {
      "name": "Parallel",
      "icon": "layer-group",
      "isComposite": true,
      "description": "同时执行所有子节点",
      "properties": [
        {
          "name": "Policy",
          "type": "enum",
          "values": ["RequireOne", "RequireAll"],
          "default": "RequireAll",
          "description": "需要多少个子节点成功"
        }
      ]
    },
    {
      "name": "ActionBase",
      "icon": "gear",
      "isAbstract": true,
      "properties": [
        {
          "name": "Timeout",
          "type": "number",
          "min": 0,
          "max": 60,
          "default": 5,
          "description": "动作超时放弃前的秒数"
        }
      ]
    },
    {
      "name": "Targetable",
      "isAbstract": true,
      "properties": [
        {
          "name": "Target",
          "type": "identifier",
          "default": "Enemy"
        }
      ]
    },
    {
      "name": "MoveTo",
      "base": "ActionBase",
      "icon": "person-walking",
      "color": "#955cc6",
      "description": "以速度 {{Speed}} 移动到 {{Target}}",
      "properties": [
        {
          "name": "Target",
          "type": "string"
        },
        {
          "name": "Speed",
          "type": "number",
          "min": 0,
          "max": 100,
          "default": 50
        },
        {
          "name": "Mode",
          "type": "enum",
          "values": ["Walk", "Run", "Sprint"],
          "default": "Walk"
        }
      ]
    },
    {
      "name": "Attack",
      "base": ["ActionBase", "Targetable"],
      "icon": "crosshairs",
      "color": "#955cc6",
      "description": "攻击 {{Target}}",
      "properties": [
        {
          "name": "Damage",
          "type": "number",
          "min": 1,
          "max": 999
        },
        {
          "name": "Melee",
          "type": "bool",
          "default": true
        },
        {
          "name": "Id",
          "type": "identifier"
        }
      ]
    },
    {
      "name": "Wait",
      "base": "ActionBase",
      "icon": "hourglass-half",
      "color": "#955cc6",
      "description": "等待 {{Timeout}} 秒"
    }
  ],
  "decorators": [
    {
      "name": "Failure",
      "icon": "thumbs-down"
    },
    {
      "name": "Invert",
      "icon": "right-left"
    },
    {
      "name": "Success",
      "icon": "thumbs-up"
    },
    {
      "name": "IsBlackboardValueSet",
      "icon": "table",
      "description": "黑板值 \"{{Field}}\" 已设置",
      "properties": [
        {
          "name": "Field",
          "type": "identifier"
        }
      ]
    },
    {
      "name": "Cooldown",
      "icon": "clock",
      "description": "冷却 {{Seconds}} 秒",
      "properties": [
        {
          "name": "Seconds",
          "type": "seconds",
          "min": 0,
          "default": 1
        }
      ]
    }
  ],
  "services": [
    {
      "name": "Sample service",
      "icon": "gear",
      "description": "示例服务",
      "properties": [
        {
          "name": "BlackboardKey",
          "type": "string",
          "default": "Target"
        }
      ]
    },
    {
      "name": "UpdateTarget",
      "icon": "bullseye",
      "color": "#5cc690",
      "description": "每次 tick 更新 {{Key}}",
      "properties": [
        {
          "name": "Key",
          "type": "identifier",
          "default": "Target"
        }
      ]
    }
  ]
}
