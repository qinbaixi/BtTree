{
  "types": {
    "blackboardKey": {
      "type": "string",
      "pattern": "[A-Za-z_][A-Za-z0-9_]*"
    },
    "ticks": {
      "type": "number"
    }
  },
  "nodes": [
    {
      "name": "Selector",
      "icon": "question",
      "color": "#d08038",
      "isComposite": true,
      "description": "依次执行子节点，直到有一个成功"
    },
    {
      "name": "Sequence",
      "icon": "arrow-right",
      "color": "#d08038",
      "isComposite": true,
      "description": "依次执行子节点，直到有一个失败"
    },
    {
      "name": "Parallel",
      "icon": "bars",
      "color": "#d08038",
      "isComposite": true,
      "description": "同时执行所有子节点（{{Policy}}）",
      "properties": [
        {
          "name": "Policy",
          "type": "enum",
          "values": ["RequireAll", "RequireOne"],
          "default": "RequireAll",
          "description": "RequireAll：全部成功才成功；RequireOne：一个成功就成功"
        }
      ]
    },
    {
      "name": "UtilitySelector",
      "icon": "scale-balanced",
      "color": "#d08038",
      "isComposite": true,
      "description": "效用选择：给每个子节点打分，执行分数最高的（{{Selection}}）",
      "properties": [
        {
          "name": "OnChildFailure",
          "type": "enum",
          "values": ["TryNext", "Fail"],
          "default": "TryNext",
          "description": "TryNext：选中的子节点失败后按分数试下一个；Fail：直接失败"
        },
        {
          "name": "Selection",
          "type": "enum",
          "values": ["Highest", "WeightedRandom"],
          "default": "Highest",
          "description": "Highest：选最高分；WeightedRandom：在前 RandomTop 名里按分数加权随机"
        },
        {
          "name": "RandomTop",
          "type": "number",
          "min": 0,
          "default": 0,
          "description": "WeightedRandom 时参与随机的名次数，0 = 全部"
        },
        {
          "name": "MinScore",
          "type": "number",
          "min": 0,
          "default": 0,
          "description": "低于这个分数的子节点不执行"
        }
      ],
      "simulate": {
        "composite": "utility"
      }
    },
    {
      "name": "ActionBase",
      "isAbstract": true,
      "icon": "gear",
      "description": "动作基类"
    },
    {
      "name": "MoveTo",
      "base": "ActionBase",
      "icon": "person-walking",
      "description": "以速度 {{Speed}} 移动到 {{Target}}（距离 {{Distance}}）",
      "properties": [
        {
          "name": "Target",
          "type": "string",
          "default": "Waypoint"
        },
        {
          "name": "Speed",
          "type": "number",
          "min": 0.5,
          "max": 10,
          "default": 1,
          "description": "每 tick 的移动距离"
        },
        {
          "name": "Distance",
          "type": "number",
          "min": 0,
          "default": 3,
          "description": "到达所需距离"
        }
      ],
      "simulate": {
        "mode": "rule",
        "duration": "{{Distance}} / {{Speed}}",
        "effects": ["Position = {{Target}}"]
      }
    },
    {
      "name": "Attack",
      "base": "ActionBase",
      "icon": "crosshairs",
      "description": "攻击（需要弹药，消耗 1 发）",
      "simulate": {
        "mode": "rule",
        "duration": 1,
        "condition": "Ammo > 0",
        "effects": ["Ammo = Ammo - 1"]
      }
    },
    {
      "name": "Reload",
      "base": "ActionBase",
      "icon": "rotate",
      "description": "装填弹药，耗时 2 tick",
      "simulate": {
        "mode": "rule",
        "duration": 2,
        "effects": ["Ammo = 3"]
      }
    },
    {
      "name": "Wait",
      "base": "ActionBase",
      "icon": "hourglass-half",
      "description": "等待 {{Duration}} tick",
      "properties": [
        {
          "name": "Duration",
          "type": "ticks",
          "min": 0,
          "default": 2
        }
      ],
      "simulate": {
        "mode": "rule",
        "duration": "{{Duration}}"
      }
    },
    {
      "name": "Say",
      "base": "ActionBase",
      "icon": "message",
      "description": "喊话：{{Message}}",
      "properties": [
        {
          "name": "Message",
          "type": "string",
          "default": "Hello"
        }
      ],
      "simulate": {
        "mode": "success",
        "effects": ["LastSaid = {{Message}}"]
      }
    },
    {
      "name": "Fail",
      "base": "ActionBase",
      "icon": "xmark",
      "description": "总是失败",
      "simulate": {
        "mode": "failure"
      }
    },
    {
      "name": "AskDesigner",
      "base": "ActionBase",
      "icon": "user",
      "color": "#c6a35c",
      "description": "手动决定结果（运行模式里点 Succeed / Fail）"
    },
    {
      "name": "SubTree",
      "icon": "diagram-project",
      "subtree": true,
      "description": "运行子树 {{Tree}}",
      "properties": [
        {
          "name": "Tree",
          "type": "string",
          "default": "",
          "description": "要运行的树文件，相对项目目录的路径"
        }
      ]
    }
  ],
  "decorators": [
    {
      "name": "Utility",
      "icon": "scale-balanced",
      "description": "固定分数 {{Score}}",
      "properties": [
        {
          "name": "Score",
          "type": "number",
          "min": 0,
          "default": 0.5,
          "description": "效用分数，父节点为 UtilitySelector 时使用"
        }
      ],
      "simulate": {
        "score": "{{Score}}"
      }
    },
    {
      "name": "Consideration",
      "icon": "chart-line",
      "description": "{{Input}}（{{Min}}–{{Max}}）经 {{Curve}} 曲线打分",
      "properties": [
        {
          "name": "Input",
          "type": "blackboardKey",
          "default": "Health",
          "description": "作为输入的黑板键"
        },
        {
          "name": "Min",
          "type": "number",
          "default": 0
        },
        {
          "name": "Max",
          "type": "number",
          "default": 100
        },
        {
          "name": "Curve",
          "type": "enum",
          "values": ["Linear", "InverseLinear", "Quadratic", "InverseQuadratic", "Logistic", "InverseLogistic", "Step", "InverseStep"],
          "default": "Linear",
          "description": "把归一化到 0–1 的输入映射成分数的响应曲线"
        }
      ],
      "simulate": {
        "score": "curve({{Curve}}, normalize(get({{Input}}), {{Min}}, {{Max}}))"
      }
    },
    {
      "name": "HasEnemy",
      "icon": "eye",
      "description": "视野内有敌人",
      "simulate": {
        "condition": "Enemy == true"
      }
    },
    {
      "name": "Invert",
      "icon": "right-left",
      "description": "反转结果",
      "simulate": {
        "decorator": "invert"
      }
    },
    {
      "name": "ForceSuccess",
      "icon": "thumbs-up",
      "description": "强制成功",
      "simulate": {
        "decorator": "forceSuccess"
      }
    },
    {
      "name": "Cooldown",
      "icon": "clock",
      "description": "冷却 {{Seconds}} 秒（1 tick = 1 秒）",
      "properties": [
        {
          "name": "Seconds",
          "type": "ticks",
          "min": 0,
          "default": 5
        }
      ],
      "simulate": {
        "decorator": "cooldown",
        "ticks": "{{Seconds}}"
      }
    },
    {
      "name": "Loop",
      "icon": "repeat",
      "description": "循环 {{Count}} 次",
      "properties": [
        {
          "name": "Count",
          "type": "number",
          "min": -1,
          "default": 3,
          "description": "-1 表示无限循环"
        }
      ],
      "simulate": {
        "decorator": "loop",
        "count": "{{Count}}"
      }
    },
    {
      "name": "TimeLimit",
      "icon": "stopwatch",
      "description": "限时 {{Seconds}} 秒",
      "properties": [
        {
          "name": "Seconds",
          "type": "ticks",
          "min": 0,
          "default": 5
        }
      ],
      "simulate": {
        "decorator": "timeLimit",
        "ticks": "{{Seconds}}"
      }
    }
  ],
  "services": [
    {
      "name": "ScanForEnemy",
      "icon": "binoculars",
      "description": "每 tick 扫描一次，计数 ScanCount",
      "simulate": {
        "effects": ["ScanCount = ScanCount + 1"]
      }
    }
  ],
  "scenarios": [
    {
      "name": "Enemy in sight",
      "description": "有敌人，只剩 1 发弹药：打一枪后需要装填",
      "trees": "trees/guard.json",
      "blackboard": {
        "Enemy": true,
        "Ammo": 1,
        "ScanCount": 0
      },
      "expect": {
        "result": "success",
        "ticks": 11,
        "blackboard": {
          "Ammo": 0,
          "LastSaid": "Alert!"
        }
      }
    },
    {
      "name": "No enemy",
      "description": "没有敌人：巡逻",
      "trees": "trees/guard.json",
      "blackboard": {
        "Enemy": false,
        "Ammo": 3,
        "ScanCount": 0
      },
      "maxTicks": 20,
      "manual": "success",
      "expect": {
        "result": "success",
        "blackboard": {
          "Position": "Waypoint B",
          "ScanCount": 8,
          "LastSaid": null
        }
      }
    },
    {
      "name": "Out of ammo",
      "description": "有敌人但没有弹药：先装填再攻击",
      "blackboard": {
        "Enemy": true,
        "Ammo": 0,
        "ScanCount": 0
      },
      "trees": ["trees/*.json"],
      "expect": {
        "result": "success",
        "blackboard": {
          "Ammo": 0
        }
      }
    },
    {
      "name": "Healthy fighter",
      "description": "效用 AI：血量高、有弹药，选择攻击",
      "trees": "trees/ai/fighter.json",
      "blackboard": {
        "Health": 90,
        "Ammo": 2
      },
      "expect": {
        "result": "success",
        "blackboard": {
          "Ammo": 1
        }
      }
    },
    {
      "name": "Wounded fighter",
      "description": "效用 AI：血量低，撤退分数最高",
      "trees": "trees/ai/fighter.json",
      "blackboard": {
        "Health": 15,
        "Ammo": 2
      },
      "expect": {
        "result": "success",
        "blackboard": {
          "Position": "Cover",
          "Ammo": 2
        }
      }
    },
    {
      "name": "Empty fighter",
      "description": "效用 AI：没有弹药，攻击分数为 0，选择装填",
      "trees": "trees/ai/fighter.json",
      "blackboard": {
        "Health": 90,
        "Ammo": 0
      },
      "expect": {
        "result": "success",
        "blackboard": {
          "Ammo": 3
        }
      }
    }
  ],
  "blackboard": [
    { "name": "Enemy", "type": "bool", "default": false, "description": "视野内有敌人" },
    { "name": "Ammo", "type": "number", "default": 3, "description": "剩余弹药" },
    { "name": "Health", "type": "number", "default": 100, "description": "血量（效用 AI 示例）" },
    { "name": "ScanCount", "type": "number", "default": 0, "description": "扫描次数" },
    { "name": "Position", "type": "string", "default": "", "description": "当前位置（MoveTo 写入）" },
    { "name": "LastSaid", "type": "string", "default": "", "description": "最近一次喊话（Say 写入）" }
  ]
}
